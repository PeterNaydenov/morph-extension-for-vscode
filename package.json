{
  "name": "morph-template-syntax-highlighting",
  "displayName": "Morph Template Syntax Highlighting",
  "description": "Syntax highlighting for .morph template files with light/dark theme variants, placeholder detection and section highlighting",
  "version": "0.0.6",
  "publisher": "peternaydenov",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:morph"
  ],
  "contributes": {
    "languages": [
      {
        "id": "morph",
        "aliases": [
          "Morph",
          "morph"
        ],
        "extensions": [
          ".morph"
        ],
        "configuration": "./src/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "morph",
        "scopeName": "source.morph",
        "path": "./src/syntaxes/morph.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Morph Light",
        "uiTheme": "vs",
        "type": "light",
        "path": "./src/themes/morph-light.json"
      },
      {
        "label": "Morph Dark",
        "uiTheme": "vs-dark",
        "type": "dark",
        "path": "./src/themes/morph-dark.json"
      }
    ],
    "commands": [
      {
        "command": "morph.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node ./out/test/runTest.js",
    "test:contrast": "node scripts/check-contrast.js",
    "validate:theme": "npm run test:contrast", 
    "publish": "npx vsce publish"
  },
  "icon": "morph.syntax.highlight.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/morph-extension-for-vscode.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "color-contrast-checker": "^2.1.0",
    "contrast-ratio": "^1.1.0",
    "mocha": "^11.7.5",
    "typescript": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar@7.9.0": true
  }
}
